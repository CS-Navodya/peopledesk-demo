# Copy this file to .env and fill in real values. .env is gitignored — it will
# never be committed. For the training demo, ADMIN_PASSWORD can just be the
# same fake password used before rotation (SuperSecret123!); the point of this
# fix isn't a stronger password, it's getting the secret out of source control.

ADMIN_PASSWORD=
SLACK_WEBHOOK_URL=
AWS_ACCESS_KEY_ID=
